{
  "name": "Ogame",
  "description": "Ogame facilitations",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html",
    "default_icon": "images/logo.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.ogame.gameforge.com/*"
      ],
      "js": ["scripts/content.js"]      
    },
    {
      "matches": [
        "https://*.ogame.gameforge.com/*&component=galaxy*"
      ],
      "js": ["thirdParty/jquery-4.0.0.min.js","scripts/artefatos.js"]
    },
    {
      "matches": [
        "https://*.ogame.gameforge.com/*&component=trader*"
      ],
      "js": ["thirdParty/jquery-4.0.0.min.js", "scripts/globalFunctions.js", "scripts/leilao.js"]      
    },
    {
      "matches": [
        "https://s181-br.ogame.gameforge.com/game/index.php?page=ingame&component=supplies"
      ],
      "js": ["thirdParty/jquery-4.0.0.min.js", "scripts/globalFunctions.js", "scripts/recursos.js"]      
    }
  ]
}